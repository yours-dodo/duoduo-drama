# Shared local infrastructure defaults. Copy to .env before running compose.dev.yml.
POSTGRES_DB=duoduo_server
POSTGRES_USER=duoduo_server
POSTGRES_PASSWORD=change-me
AGENT_POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

MINIO_ROOT_USER=duoduo_server
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SERVER_OBJECT_STORAGE_BUCKET=duoduo-assets

MILVUS_IMAGE=milvusdb/milvus:v3.0.0
MILVUS_ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MILVUS_MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MILVUS_MINIO_USER=minioadmin
MILVUS_MINIO_PASSWORD=minioadmin
MILVUS_HOST_PORT=19530
MILVUS_WEBUI_HOST_PORT=9091

ELASTICSEARCH_VERSION=8.19.0
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

KAFKA_VERSION=4.0.0
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_PORT=29092
KAFKA_NUM_PARTITIONS=3
