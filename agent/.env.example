# Agent Runtime PostgreSQL. Never commit real credentials.
AGENT_RUNTIME_DATABASE_URL=postgresql://duoduo_agent:change-me@127.0.0.1:5432/duoduo_agent

# Dedicated local integration-test database used by `pnpm test:postgres`.
AGENT_TEST_POSTGRES_URL=postgresql://duoduo_agent:duoduo_agent_test@127.0.0.1:55432/duoduo_agent_test

# Story script generation. Leave STORY_TEXT_PROVIDER unset (or set to "mock")
# to use the deterministic local mock generator without any model credentials.
STORY_TEXT_PROVIDER=mock
STORY_TEXT_MODEL=deepseek-chat
# STORY_TEXT_BASE_URL=https://api.deepseek.com
# STORY_TEXT_API_KEY=

# Story scene image generation.
#
# Providers:
#   mock             - deterministic SVG placeholder (no credentials needed)
#   self-hosted      - 项目自建图片服务 POST {base}/api/generate
#   openrouter       - OpenRouter image models via @duoduo/ai
#   openai-compatible- any OpenAI-compatible /images/generations endpoint
#                      (self-hosted / one-api / LiteLLM / gateways)
STORY_IMAGE_PROVIDER=mock
STORY_IMAGE_MODEL=google/gemini-2.5-flash-image
STORY_IMAGE_SIZE=1024x1792
STORY_IMAGE_RESPONSE_FORMAT=url
STORY_IMAGE_NEGATIVE_PROMPT=低分辨率，低画质，肢体畸形，手指畸形，画面过饱和，文字模糊，扭曲
STORY_IMAGE_PROMPT_EXTEND=true
STORY_IMAGE_WATERMARK=false
# STORY_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# STORY_IMAGE_API_KEY=

# Story dialogue voice synthesis.
#
# Providers:
#   mock              - short silence WAV (no credentials needed)
#   indextts          - 项目自建 IndexTTS 服务 POST {base}/api/tts
#   openai-compatible - any OpenAI-compatible POST {baseUrl}/audio/speech
#                       endpoint (OpenAI, MiniMax, one-api, self-hosted TTS)
STORY_SPEECH_PROVIDER=mock
STORY_SPEECH_MODEL=tts-1
STORY_SPEECH_VOICE=alloy
STORY_SPEECH_RESPONSE_FORMAT=mp3
STORY_SPEECH_REFERENCE_AUDIO=voice_01.wav
STORY_SPEECH_VOICE_CATALOG=voice_01.wav,voice_02.wav,voice_03.wav,voice_04.wav,voice_05.wav,voice_06.wav,voice_07.wav,voice_08.wav,voice_09.wav,voice_11.wav,voice_12.wav,emo_hate.wav,emo_sad.wav
STORY_SPEECH_LANG=ZH
STORY_SPEECH_DURATION_FACTOR=1
STORY_SPEECH_EMOTION_ALPHA=1
# STORY_SPEECH_BASE_URL=https://api.openai.com/v1
# STORY_SPEECH_API_KEY=

# Story short-video rendering. Uses the local ffmpeg/ffprobe binaries; no
# provider credentials needed. Output mp4 + .srt sidecar land in STORY_VIDEO_OUTPUT_DIR.
STORY_FFMPEG_PATH=ffmpeg
STORY_FFPROBE_PATH=ffprobe
STORY_VIDEO_OUTPUT_DIR=/tmp/duoduo-videos
STORY_VIDEO_WIDTH=1080
STORY_VIDEO_HEIGHT=1920
STORY_VIDEO_FPS=30

# Browser origins allowed to call the Agent service (comma-separated).
# AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
