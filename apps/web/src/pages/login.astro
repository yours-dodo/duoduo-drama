---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="登录｜多多剧场"
  description="登录多多剧场，继续你的故事创作和短剧制作。"
>
  <section class="auth-page" aria-labelledby="login-title">
    <div class="auth-card auth-card-wide">
      <p class="eyebrow">欢迎回来</p>
      <h1 id="login-title">继续你的<br /><em>创作。</em></h1>
      <p class="auth-description">用邮箱验证码或密码登录你的多多剧场账号。</p>

      <div class="auth-tabs" role="tablist" aria-label="登录方式">
        <button class="auth-tab is-active" type="button" role="tab" aria-selected="true" data-auth-mode="code">
          验证码登录
        </button>
        <button class="auth-tab" type="button" role="tab" aria-selected="false" data-auth-mode="password">
          密码登录
        </button>
      </div>

      <section class="auth-mode" data-auth-panel="code" aria-labelledby="code-login-title">
        <h2 id="code-login-title" class="sr-only">邮箱验证码登录</h2>
        <form class="auth-form" id="code-request-form">
          <label for="code-email">邮箱地址</label>
          <input id="code-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          <button class="button button-primary" type="submit">发送验证码 <span aria-hidden="true">↗</span></button>
        </form>
        <form class="auth-form is-hidden" id="code-verify-form">
          <label for="login-code">输入 6 位验证码</label>
          <input id="login-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required />
          <button class="button button-primary" type="submit">验证并登录 <span aria-hidden="true">↗</span></button>
          <button class="auth-secondary-button" id="code-resend" type="button">重新发送验证码</button>
        </form>
        <p class="auth-note" id="code-status" role="status">验证码会打印在 Server 开发控制台，有效期 10 分钟。</p>
      </section>

      <section class="auth-mode is-hidden" data-auth-panel="password" aria-labelledby="password-login-title">
        <h2 id="password-login-title" class="sr-only">邮箱密码登录</h2>
        <form class="auth-form" id="password-form">
          <label for="password-email">邮箱地址</label>
          <input id="password-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          <label for="password">密码</label>
          <input id="password" name="password" type="password" autocomplete="current-password" minlength="8" maxlength="128" placeholder="至少 8 个字符" required />
          <button class="button button-primary" type="submit">登录 <span aria-hidden="true">↗</span></button>
        </form>
        <button class="text-link auth-inline-link" id="forgot-password" type="button">忘记密码？使用验证码重置</button>
        <p class="auth-note" id="password-status" role="status">还没有设置密码？可以先使用验证码登录。</p>
      </section>

      <section class="auth-mode is-hidden" data-auth-panel="reset" aria-labelledby="reset-password-title">
        <h2 id="reset-password-title">重置密码</h2>
        <p class="auth-description">输入账号邮箱，验证码会打印在 Server 开发控制台。</p>
        <form class="auth-form" id="reset-request-form">
          <label for="reset-email">邮箱地址</label>
          <input id="reset-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          <button class="button button-primary" type="submit">发送重置验证码 <span aria-hidden="true">↗</span></button>
        </form>
        <form class="auth-form is-hidden" id="reset-verify-form">
          <label for="reset-code">验证码</label>
          <input id="reset-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required />
          <label for="reset-password">新密码</label>
          <input id="reset-password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="至少 8 个字符" required />
          <label for="reset-password-confirm">确认新密码</label>
          <input id="reset-password-confirm" name="password-confirm" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="再次输入密码" required />
          <button class="button button-primary" type="submit">重置并登录 <span aria-hidden="true">↗</span></button>
        </form>
        <button class="text-link auth-inline-link" id="back-to-password" type="button">← 返回密码登录</button>
        <p class="auth-note" id="reset-status" role="status"></p>
      </section>

      <a class="text-link" href="/">← 返回首页</a>
    </div>
  </section>
</BaseLayout>

<script>
  const panels = document.querySelectorAll<HTMLElement>('[data-auth-panel]');
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-auth-mode]');
  const codeEmail = document.querySelector<HTMLInputElement>('#code-email');
  const codeRequestForm = document.querySelector<HTMLFormElement>('#code-request-form');
  const codeVerifyForm = document.querySelector<HTMLFormElement>('#code-verify-form');
  const codeStatus = document.querySelector<HTMLElement>('#code-status');
  const passwordForm = document.querySelector<HTMLFormElement>('#password-form');
  const passwordStatus = document.querySelector<HTMLElement>('#password-status');
  const resetEmail = document.querySelector<HTMLInputElement>('#reset-email');
  const resetRequestForm = document.querySelector<HTMLFormElement>('#reset-request-form');
  const resetVerifyForm = document.querySelector<HTMLFormElement>('#reset-verify-form');
  const resetStatus = document.querySelector<HTMLElement>('#reset-status');
  const nextPath = (): string => {
    const requested = new URLSearchParams(window.location.search).get('next');
    return requested?.startsWith('/') && !requested.startsWith('//') ? requested : '/app';
  };

  const setMode = (mode: string) => {
    panels.forEach((panel) => {
      panel.classList.toggle('is-hidden', panel.dataset.authPanel !== mode);
    });
    tabs.forEach((tab) => {
      const active = tab.dataset.authMode === mode;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
    });
  };

  const setBusy = (form: HTMLFormElement | null, busy: boolean) => {
    form?.querySelectorAll('button').forEach((button) => {
      button.disabled = busy;
    });
  };

  const readError = async (response: Response, fallback: string): Promise<string> => {
    try {
      const body = await response.json();
      return body.error?.message ?? fallback;
    } catch {
      return fallback;
    }
  };

  const request = async (
    path: string,
    body: Record<string, string | undefined>,
  ): Promise<Record<string, any>> => {
    const response = await fetch(path, {
      method: 'POST',
      credentials: 'include',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(body),
    });
    if (!response.ok) {
      throw new Error(await readError(response, '暂时无法完成操作，请稍后重试。'));
    }
    return response.json();
  };

  const errorMessage = (error: unknown): string =>
    error instanceof Error ? error.message : '暂时无法完成操作，请稍后重试。';

  tabs.forEach((tab) => tab.addEventListener('click', () => setMode(tab.dataset.authMode ?? 'code')));

  codeRequestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!codeEmail || !codeStatus || !codeRequestForm.checkValidity()) return;
    setBusy(codeRequestForm, true);
    codeStatus.textContent = '正在生成验证码…';
    try {
      await request('/api/v1/auth/email-code-requests', { email: codeEmail.value });
      codeRequestForm.classList.add('is-hidden');
      codeVerifyForm?.classList.remove('is-hidden');
      codeStatus.textContent = '验证码已生成，请查看 Server 开发控制台。';
      document.querySelector<HTMLInputElement>('#login-code')?.focus();
    } catch (error) {
      codeStatus.textContent = errorMessage(error);
    } finally {
      setBusy(codeRequestForm, false);
    }
  });

  document.querySelector<HTMLButtonElement>('#code-resend')?.addEventListener('click', () => codeRequestForm?.requestSubmit());

  codeVerifyForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const code = document.querySelector<HTMLInputElement>('#login-code');
    if (!codeEmail || !code || !codeStatus || !codeVerifyForm.checkValidity()) return;
    setBusy(codeVerifyForm, true);
    codeStatus.textContent = '正在验证…';
    try {
      const result = await request('/api/v1/auth/email-code-verifications', {
        email: codeEmail.value,
        code: code.value,
      });
      const destination = nextPath();
      window.location.assign(
        result.hasPassword
          ? destination
          : `/account/password?next=${encodeURIComponent(destination)}`,
      );
    } catch (error) {
      codeStatus.textContent = errorMessage(error);
    } finally {
      setBusy(codeVerifyForm, false);
    }
  });

  passwordForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = document.querySelector<HTMLInputElement>('#password-email');
    const password = document.querySelector<HTMLInputElement>('#password');
    if (!email || !password || !passwordStatus || !passwordForm.checkValidity()) return;
    setBusy(passwordForm, true);
    passwordStatus.textContent = '正在登录…';
    try {
      await request('/api/v1/auth/password-logins', {
        email: email.value,
        password: password.value,
      });
      window.location.assign(nextPath());
    } catch (error) {
      passwordStatus.textContent = errorMessage(error);
    } finally {
      setBusy(passwordForm, false);
    }
  });

  document.querySelector('#forgot-password')?.addEventListener('click', () => {
    const email = document.querySelector<HTMLInputElement>('#password-email');
    if (email?.value && resetEmail) resetEmail.value = email.value;
    setMode('reset');
  });

  resetRequestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!resetEmail || !resetStatus || !resetRequestForm.checkValidity()) return;
    setBusy(resetRequestForm, true);
    resetStatus.textContent = '正在生成重置验证码…';
    try {
      await request('/api/v1/auth/password-reset-requests', { email: resetEmail.value });
      resetRequestForm.classList.add('is-hidden');
      resetVerifyForm?.classList.remove('is-hidden');
      resetStatus.textContent = '验证码已生成，请查看 Server 开发控制台。';
      document.querySelector<HTMLInputElement>('#reset-code')?.focus();
    } catch (error) {
      resetStatus.textContent = errorMessage(error);
    } finally {
      setBusy(resetRequestForm, false);
    }
  });

  resetVerifyForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const code = document.querySelector<HTMLInputElement>('#reset-code');
    const password = document.querySelector<HTMLInputElement>('#reset-password');
    const confirm = document.querySelector<HTMLInputElement>('#reset-password-confirm');
    if (!resetEmail || !code || !password || !confirm || !resetStatus || !resetVerifyForm.checkValidity()) return;
    if (password.value !== confirm.value) {
      resetStatus.textContent = '两次输入的密码不一致。';
      return;
    }
    setBusy(resetVerifyForm, true);
    resetStatus.textContent = '正在重置密码…';
    try {
      await request('/api/v1/auth/password-reset-verifications', {
        email: resetEmail.value,
        code: code.value,
        password: password.value,
      });
      window.location.assign(nextPath());
    } catch (error) {
      resetStatus.textContent = errorMessage(error);
    } finally {
      setBusy(resetVerifyForm, false);
    }
  });

  document.querySelector('#back-to-password')?.addEventListener('click', () => setMode('password'));
</script>
