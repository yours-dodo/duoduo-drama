---
import AuthGate from '../../components/astro/AuthGate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="设置密码｜多多剧场" description="为你的多多剧场账号设置登录密码。" pageClass="login-page" robots="noindex,nofollow">
  <AuthGate>
    <section class="auth-page" aria-labelledby="password-title">
      <div class="password-layout">
        <aside class="login-rail password-rail" aria-label="多多剧场故事创作入口">
          <span class="login-rail-kicker">STORY CREATION UNIVERSE</span>
          <span class="login-rail-mark" aria-hidden="true">多</span>
          <div class="story-rail-map" aria-hidden="true">
            <span class="story-rail-node">IDEA</span>
            <i></i>
            <span class="story-rail-node is-active">STORY</span>
            <i></i>
            <span class="story-rail-node">EPISODE</span>
          </div>
          <h2>把入口留给未来，<em>继续你的世界。</em></h2>
          <p>设置密码后，下次可以更快回到你的创作空间。</p>
        </aside>
        <div class="auth-card password-card">
        <p class="eyebrow">账号设置</p>
        <h1 id="password-title">设置一个新的<br /><em>入口。</em></h1>
        <p class="auth-description">设置密码后，下次可以更快回到你的创作空间。</p>
        <form class="auth-form" id="set-password-form">
          <label for="current-password">当前密码（修改密码时填写）</label>
          <div class="auth-password-field">
            <input id="current-password" name="current-password" type="password" autocomplete="current-password" minlength="8" maxlength="128" placeholder="首次设置可留空" />
            <button class="password-toggle" type="button" data-password-toggle="current-password" aria-label="显示密码" aria-pressed="false"><span aria-hidden="true">◉</span></button>
          </div>
          <label for="new-password">新密码</label>
          <div class="auth-password-field">
            <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="至少 8 个字符" required />
            <button class="password-toggle" type="button" data-password-toggle="new-password" aria-label="显示密码" aria-pressed="false"><span aria-hidden="true">◉</span></button>
          </div>
          <label for="confirm-password">确认新密码</label>
          <div class="auth-password-field">
            <input id="confirm-password" name="confirm-password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="再次输入密码" required />
            <button class="password-toggle" type="button" data-password-toggle="confirm-password" aria-label="显示密码" aria-pressed="false"><span aria-hidden="true">◉</span></button>
          </div>
          <button class="button button-primary" type="submit">保存并继续 <span aria-hidden="true">↗</span></button>
        </form>
        <p class="auth-note" id="set-password-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </AuthGate>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#set-password-form');
  const status = document.querySelector<HTMLElement>('#set-password-status');

  document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>(`#${toggle.dataset.passwordToggle}`);
      if (!input) return;
      const visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      toggle.setAttribute('aria-pressed', String(!visible));
      toggle.setAttribute('aria-label', visible ? '显示密码' : '隐藏密码');
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const currentPassword = document.querySelector<HTMLInputElement>('#current-password');
    const password = document.querySelector<HTMLInputElement>('#new-password');
    const confirm = document.querySelector<HTMLInputElement>('#confirm-password');
    if (!currentPassword || !password || !confirm || !status || !form.checkValidity()) return;
    if (password.value !== confirm.value) {
      status.textContent = '两次输入的密码不一致。';
      status.dataset.state = 'error';
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.setAttribute('aria-busy', 'true');
    if (button) button.disabled = true;
    status.textContent = '正在保存…';
    status.dataset.state = 'pending';
    try {
      const response = await fetch('/api/v1/auth/passwords', {
        method: 'POST',
        credentials: 'include',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          currentPassword: currentPassword.value || undefined,
          password: password.value,
        }),
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.error?.message ?? '暂时无法保存，请稍后重试。');
      }
      const next = new URLSearchParams(window.location.search).get('next');
      window.location.assign(next?.startsWith('/') ? next : '/workspace');
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : '暂时无法保存，请稍后重试。';
      status.dataset.state = 'error';
    } finally {
      form.setAttribute('aria-busy', 'false');
      if (button) button.disabled = false;
    }
  });
</script>
