---
import AuthGate from '../../components/astro/AuthGate.astro';
import StorySidebar from '../../components/astro/StorySidebar.astro';
import StoryApp from '../../workspaces/story/StoryApp.vue';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="故事创作｜多多剧场"
  description="在多多剧场中发展故事、对话和剧本。"
  pageClass="story-page story-catalog-page"
>
  <AuthGate>
    <StorySidebar activePath="/stories" />
    <StoryApp client:load />
  </AuthGate>
</BaseLayout>
