---
import AuthGate from '../../components/astro/AuthGate.astro';
import StorySubroutePage from '../../components/astro/StorySubroutePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="沉浸式创作｜多多剧场"
  description="在沉浸式创作中连续推进你的故事。"
  pageClass="story-page story-catalog-page story-subroute-page"
>
  <AuthGate>
    <StorySubroutePage
      activePath="/stories/immersive"
      index="02"
      title="沉浸式创作"
      description="进入连续的故事现场，让人物、情节和选择保持在同一条创作路径上。"
    />
  </AuthGate>
</BaseLayout>
