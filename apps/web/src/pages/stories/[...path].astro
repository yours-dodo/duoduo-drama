---
import AuthGate from '../../components/astro/AuthGate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryWorkspaceApp from '../../workspaces/story/views/stories/StoryWorkspaceApp.vue';

export const prerender = false;

const initialPath = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`;
---

<BaseLayout
  title="故事创作｜多多剧场"
  description="在多多剧场中发展故事、对话和剧本。"
  pageClass="story-page story-catalog-page"
  showSiteHeader={false}
>
  <AuthGate>
    <StoryWorkspaceApp client:only="vue" initialPath={initialPath} />
  </AuthGate>
</BaseLayout>
