---
import AuthGate from '../components/astro/AuthGate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="选择创作空间｜多多剧场"
  description="选择你的多多剧场个人或团队创作空间。"
  pageClass="onboarding-page"
  robots="noindex,nofollow"
>
  <AuthGate>
    <section class="onboarding-shell onboarding-choice-shell" aria-labelledby="onboarding-title">
      <div class="onboarding-choice-layout">
        <div class="onboarding-choice-intro">
          <div class="onboarding-choice-visual" aria-hidden="true">
            <div class="onboarding-choice-visual-topline">
              <span>DUODUO / CREATIVE ENTRY</span>
              <span>SETUP 01 / READY</span>
            </div>
            <div class="onboarding-choice-visual-center">
              <span class="onboarding-choice-visual-mark">多</span>
              <strong>开始创作</strong>
              <small>从一个适合你的空间开始。</small>
            </div>
            <span class="onboarding-choice-visual-node onboarding-choice-visual-node-personal">PERSONAL</span>
            <span class="onboarding-choice-visual-node onboarding-choice-visual-node-team">TEAM</span>
            <i class="onboarding-choice-visual-line onboarding-choice-visual-line-personal"></i>
            <i class="onboarding-choice-visual-line onboarding-choice-visual-line-team"></i>
            <span class="onboarding-choice-visual-stamp">SPACE / READY TO START</span>
            <div class="onboarding-choice-visual-footer">
              <span>BUILD YOUR STORY UNIVERSE</span>
              <span><i></i> CHOOSE YOUR SPACE</span>
            </div>
          </div>
          <div class="onboarding-choice-copy">
            <p class="onboarding-panel-kicker">START HERE</p>
            <h1 id="onboarding-title">选择你的<br /><em>创作空间。</em></h1>
            <p>一个人专注创作，或和伙伴一起推进故事。先选择适合此刻的工作方式。</p>
          </div>
        </div>

        <div class="onboarding-choice-panel">
          <div class="onboarding-panel-header">
            <span>CREATIVE SPACE / ENTRY</span>
            <span>01 / 02</span>
          </div>
          <div class="onboarding-panel-rule" aria-hidden="true"></div>
          <div class="onboarding-choice-panel-copy">
            <p class="onboarding-panel-kicker">CHOOSE YOUR PATH</p>
            <h2>从哪里开始？</h2>
            <p>你的选择只决定当前进入的创作上下文，之后仍可继续探索更多工作方式。</p>
          </div>

          <div class="onboarding-choice-list">
            <a class="onboarding-choice-card onboarding-choice-card-personal" href="/workspace">
              <div class="onboarding-choice-card-topline">
                <span>01 / PERSONAL</span>
                <span aria-hidden="true">↗</span>
              </div>
              <div class="onboarding-choice-card-icon" aria-hidden="true">P</div>
              <div class="onboarding-choice-card-copy">
                <h2>个人创作空间</h2>
                <p>一个人整理灵感、发展故事，专注完成自己的作品。</p>
              </div>
              <span class="onboarding-choice-card-action">进入个人空间</span>
            </a>

            <a class="onboarding-choice-card onboarding-choice-card-team" href="/onboarding/team">
              <div class="onboarding-choice-card-topline">
                <span>02 / TEAM</span>
                <span aria-hidden="true">↗</span>
              </div>
              <div class="onboarding-choice-card-icon" aria-hidden="true">T</div>
              <div class="onboarding-choice-card-copy">
                <h2>团队创作空间</h2>
                <p>邀请伙伴共同创作，让故事、短剧和内容生产连在一起。</p>
              </div>
              <span class="onboarding-choice-card-action">进入团队入口</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </AuthGate>
</BaseLayout>
