---
interface Props {
  activePath: '/stories/immersive' | '/stories/templates';
  title: string;
  description: string;
  index: string;
}

import StorySidebar from './StorySidebar.astro';

const { activePath, title, description, index } = Astro.props;
---

<StorySidebar activePath={activePath} />

<section
  class="workspace-shell story-workspace story-workbench story-subroute-workbench"
  aria-labelledby="story-subroute-title"
>
  <div class="story-catalog-layout">
    <div class="story-catalog-main story-subroute-main">
      <header class="story-subroute-header">
        <span class="story-subroute-index">{index}</span>
        <h1 id="story-subroute-title">{title}</h1>
        <p>{description}</p>
      </header>

      <section class="story-subroute-panel" aria-label={`${title}内容`}>
        <span class="story-subroute-kicker">当前空间</span>
        <h2>{title}</h2>
        <p>这条创作路径已经接入工作区，相关功能会在这里持续展开。</p>
      </section>
    </div>
  </div>
</section>
