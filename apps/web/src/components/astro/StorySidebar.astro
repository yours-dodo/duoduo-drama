---
interface Props {
  activePath: '/stories' | '/stories/immersive' | '/stories/templates';
}

const { activePath } = Astro.props;
const navigation = [
  { href: '/stories', label: '创作空间' },
  { href: '/stories/immersive', label: '沉浸式创作' },
  { href: '/stories/templates', label: '模版库' },
];
---

<aside class="story-floating-sidebar" aria-label="故事工作区功能导航">
  <div class="story-floating-sidebar-top">
    <span class="story-floating-sidebar-trigger">
      <span class="story-floating-sidebar-logo" aria-hidden="true">多</span>
    </span>
    <button
        class="story-floating-sidebar-toggle"
        type="button"
        data-story-sidebar-toggle
        aria-controls="story-sidebar-navigation"
        aria-expanded="true"
        aria-label="折叠导航栏"
        title="折叠导航栏"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M9.67272 0.522841C10.8339 0.522841 11.76 0.522714 12.4963 0.602493C13.2453 0.683657 13.8789 0.854248 14.4264 1.25197C14.7504 1.48739 15.0355 1.77247 15.2709 2.0965C15.6686 2.64394 15.8392 3.27758 15.9204 4.02655C16.0002 4.7629 16 5.68895 16 6.85014V9.14986C16 10.3111 16.0002 11.2371 15.9204 11.9735C15.8392 12.7224 15.6686 13.3561 15.2709 13.9035C15.0355 14.2275 14.7504 14.5126 14.4264 14.748C13.8789 15.1458 13.2453 15.3163 12.4963 15.3975C11.76 15.4773 10.8339 15.4772 9.67272 15.4772H6.3273C5.16611 15.4772 4.24006 15.4773 3.50371 15.3975C2.75474 15.3163 2.1211 15.1458 1.57366 14.748C1.24963 14.5126 0.964549 14.2275 0.729131 13.9035C0.331407 13.3561 0.160817 12.7224 0.0796529 11.9735C-0.000126137 11.2371 1.25338e-09 10.3111 1.25338e-09 9.14986V6.85014C1.25329e-09 5.68895 -0.000126137 4.7629 0.0796529 4.02655C0.160817 3.27758 0.331407 2.64394 0.729131 2.0965C0.964549 1.77247 1.24963 1.48739 1.57366 1.25197C2.1211 0.854248 2.75474 0.683657 3.50371 0.602493C4.24006 0.522714 5.16611 0.522841 6.3273 0.522841H9.67272ZM5.54303 1.88715V14.1118C5.78636 14.1128 6.04709 14.1169 6.3273 14.1169H9.67272C10.8639 14.1164 11.7032 14.1164 12.3493 14.0465C12.9824 13.9779 13.3497 13.8494 13.6268 13.6482C13.8354 13.4966 14.0195 13.3125 14.1711 13.1039C14.3723 12.8268 14.5007 12.4595 14.5693 11.8264C14.6393 11.1803 14.6398 10.341 14.6398 9.14986V6.85014C14.6398 5.65896 14.6393 4.81967 14.5693 4.1736C14.5007 3.54048 14.3723 3.17318 14.1711 2.89609C14.0195 2.68747 13.8354 2.50337 13.6268 2.35179C13.3497 2.1506 12.9824 2.02212 12.3493 1.95353C11.7032 1.88358 10.8639 1.88307 9.67272 1.88307H6.3273C6.04709 1.88307 5.78636 1.8862 5.54303 1.88715ZM4.1828 1.91166C3.99125 1.9216 3.8148 1.93577 3.65076 1.95353C3.01764 2.02212 2.65034 2.1506 2.37325 2.35179C2.16463 2.50337 1.98052 2.68747 1.82895 2.89609C1.62776 3.17318 1.49928 3.54048 1.43069 4.1736C1.36074 4.81967 1.36023 5.65896 1.36023 6.85014V9.14986C1.36023 10.341 1.36074 11.1803 1.43069 11.8264C1.49928 12.4595 1.62776 12.8268 1.82895 13.1039C1.98052 13.3125 2.16463 13.4966 2.37325 13.6482C2.65034 13.8494 3.01764 13.9779 3.65076 14.0465C3.81478 14.0642 3.99127 14.0774 4.1828 14.0873V1.91166Z" fill="currentColor"></path>
        </svg>
    </button>
  </div>
  <div class="story-floating-sidebar-content" id="story-sidebar-navigation">
    <nav class="story-floating-nav">
      {navigation.map((item) => (
        <a
          class:list={[
            'story-floating-nav-item',
            { 'is-active': activePath === item.href },
          ]}
          href={item.href}
          aria-current={activePath === item.href ? 'page' : undefined}
          aria-label={item.label}
        >
          <span class="story-floating-nav-label">{item.label}</span>
          <span class="story-floating-nav-short" aria-hidden="true">
            {item.label.slice(0, 1)}
          </span>
        </a>
      ))}
    </nav>
    <div class="story-floating-recent-collapsed">
      <button
        class="story-floating-recent-collapsed-toggle"
        type="button"
        data-story-recent-collapsed-toggle
        aria-controls="story-recent-popover"
        aria-expanded="false"
        aria-label="最近对话"
        title="最近对话"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
          <path d="M3.4 8.6A6.6 6.6 0 1 1 4.95 13" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
          <path d="M3.4 4.2v4.4h4.4M10 6.8v3.6l2.4 1.4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
        </svg>
      </button>
      <div
        id="story-recent-popover"
        class="story-floating-recent-popover"
        data-story-recent-popover
        hidden
      >
        <div class="story-floating-recent-popover-header">
          <span class="story-floating-recent-popover-title">最近</span>
          <span class="story-floating-recent-popover-hint">对话历史</span>
        </div>
        <div
          class="story-floating-recent-popover-list"
          data-story-recent-popover-list
        >
          <span
            class="story-floating-recent-empty"
            data-story-recent-popover-empty
          >
            还没有聊过的对话
          </span>
        </div>
      </div>
    </div>
    <section class="story-floating-recent" aria-labelledby="story-recent-title">
      <h2 id="story-recent-title" class="story-floating-group-title">
        <button
          class="story-floating-group-toggle"
          type="button"
          data-story-recent-toggle
          aria-controls="story-recent-list"
          aria-expanded="true"
        >
          <span>最近</span>
          <span class="story-floating-group-chevron" aria-hidden="true">⌄</span>
        </button>
      </h2>
      <div
        id="story-recent-list"
        class="story-floating-recent-list"
        data-story-recent-list
      >
        <span class="story-floating-recent-empty" data-story-recent-empty>
          还没有聊过的对话
        </span>
      </div>
    </section>
  </div>
  <div class="story-floating-user" data-story-user aria-label="当前用户">
    <span class="story-floating-user-avatar" data-story-user-initial aria-hidden="true">
      U
    </span>
    <span class="story-floating-user-copy">
      <small>当前用户</small>
      <strong data-story-user-email>读取中…</strong>
    </span>
  </div>
</aside>

<script>
  const recentStorageKey = 'duoduo-story-recent-conversations';
  const sidebarStorageKey = 'duoduo-story-sidebar';
  const sidebar = document.querySelector<HTMLElement>('.story-floating-sidebar');
  const sidebarToggle = document.querySelector<HTMLButtonElement>(
    '[data-story-sidebar-toggle]',
  );
  const userRoot = document.querySelector<HTMLElement>('[data-story-user]');
  const userEmail = userRoot?.querySelector<HTMLElement>('[data-story-user-email]');
  const userInitial = userRoot?.querySelector<HTMLElement>('[data-story-user-initial]');
  const recentList = document.querySelector<HTMLElement>('[data-story-recent-list]');
  const recentEmpty = document.querySelector<HTMLElement>('[data-story-recent-empty]');
  const recentToggle = document.querySelector<HTMLButtonElement>(
    '[data-story-recent-toggle]',
  );
  const recentCollapsedToggle = document.querySelector<HTMLButtonElement>(
    '[data-story-recent-collapsed-toggle]',
  );
  const recentPopover = document.querySelector<HTMLElement>(
    '[data-story-recent-popover]',
  );
  const recentPopoverList = document.querySelector<HTMLElement>(
    '[data-story-recent-popover-list]',
  );
  const recentPopoverEmpty = document.querySelector<HTMLElement>(
    '[data-story-recent-popover-empty]',
  );

  const applySidebarState = (isCollapsed: boolean) => {
    sidebar?.classList.toggle('is-collapsed', isCollapsed);
    document.documentElement.dataset.storySidebar = isCollapsed
      ? 'collapsed'
      : 'expanded';
    sidebarToggle?.setAttribute('aria-expanded', String(!isCollapsed));
    sidebarToggle?.setAttribute(
      'aria-label',
      isCollapsed ? '展开导航栏' : '折叠导航栏',
    );
    sidebarToggle?.setAttribute(
      'title',
      isCollapsed ? '展开导航栏' : '折叠导航栏',
    );
  };

  let sidebarCollapsed = document.documentElement.dataset.storySidebar === 'collapsed';
  try {
    sidebarCollapsed = window.localStorage.getItem(sidebarStorageKey) === 'collapsed';
  } catch {
    // Keep the head-applied state when storage is unavailable.
  }
  applySidebarState(sidebarCollapsed);
  sidebarToggle?.addEventListener('click', () => {
    sidebarCollapsed = !sidebarCollapsed;
    applySidebarState(sidebarCollapsed);
    try {
      window.localStorage.setItem(
        sidebarStorageKey,
        sidebarCollapsed ? 'collapsed' : 'expanded',
      );
    } catch {
      // The sidebar still works for this page view when storage is unavailable.
    }
  });

  type RecentConversation = {
    id: string;
    projectId: string;
    title: string;
    updatedAt: number;
  };

  const readRecentConversations = (): RecentConversation[] => {
    try {
      const value = JSON.parse(
        window.localStorage.getItem(recentStorageKey) ?? '[]',
      );
      if (!Array.isArray(value)) return [];
      return value.filter(
        (item): item is RecentConversation =>
          typeof item?.id === 'string' &&
          typeof item?.projectId === 'string' &&
          typeof item?.title === 'string' &&
          typeof item?.updatedAt === 'number',
      );
    } catch {
      return [];
    }
  };

  const renderRecentList = (
    list: HTMLElement | null,
    empty: HTMLElement | null,
    conversations: RecentConversation[],
  ) => {
    if (!list || !empty) return;
    list.querySelectorAll('[data-story-recent-link]').forEach((item) => {
      item.remove();
    });
    empty.hidden = conversations.length > 0;
    conversations.forEach((conversation) => {
      const link = document.createElement('a');
      link.className = 'story-floating-recent-item';
      link.href = `/stories/${encodeURIComponent(conversation.projectId)}`;
      link.dataset.storyRecentLink = 'true';
      link.title = conversation.title;
      link.textContent = conversation.title;
      list.append(link);
    });
  };

  const renderRecentConversations = () => {
    const conversations = readRecentConversations().slice(0, 5);
    renderRecentList(recentList, recentEmpty, conversations);
    renderRecentList(recentPopoverList, recentPopoverEmpty, conversations);
  };

  renderRecentConversations();
  recentToggle?.addEventListener('click', () => {
    if (!recentList) return;
    const isExpanded = recentToggle.getAttribute('aria-expanded') === 'true';
    recentToggle.setAttribute('aria-expanded', String(!isExpanded));
    recentList.hidden = isExpanded;
    recentToggle.closest('.story-floating-recent')?.classList.toggle(
      'is-collapsed',
      isExpanded,
    );
  });
  const setRecentPopoverOpen = (isOpen: boolean) => {
    if (!recentPopover || !recentCollapsedToggle) return;
    recentPopover.hidden = !isOpen;
    recentCollapsedToggle.setAttribute('aria-expanded', String(isOpen));
    recentCollapsedToggle.closest('.story-floating-recent-collapsed')?.classList.toggle(
      'is-open',
      isOpen,
    );
  };

  recentCollapsedToggle?.addEventListener('click', () => {
    const isOpen = recentCollapsedToggle.getAttribute('aria-expanded') === 'true';
    setRecentPopoverOpen(!isOpen);
  });
  document.addEventListener('click', (event) => {
    if (!recentPopover || recentPopover.hidden) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (
      recentPopover.contains(target) ||
      recentCollapsedToggle?.contains(target)
    ) {
      return;
    }
    setRecentPopoverOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setRecentPopoverOpen(false);
  });
  window.addEventListener('storage', (event) => {
    if (event.key === recentStorageKey) renderRecentConversations();
  });

  if (userRoot && userEmail && userInitial) {
    fetch('/api/v1/me', {
      credentials: 'include',
      headers: { Accept: 'application/json' },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((payload: { user?: { email?: string } } | null) => {
        const email = payload?.user?.email?.trim();
        if (!email) return;
        userEmail.textContent = email;
        userInitial.textContent = email.slice(0, 1).toUpperCase();
      })
      .catch(() => undefined);
  }
</script>
