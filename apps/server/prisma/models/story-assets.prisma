model Asset {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String?          @map("tenant_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  uploadedByUserId String           @map("uploaded_by_user_id") @db.Uuid
  objectKey        String           @unique(map: "assets_object_key_key") @map("object_key") @db.VarChar(512)
  originalFileName String           @map("original_file_name") @db.VarChar(255)
  contentType      String           @map("content_type") @db.VarChar(128)
  byteSize         Int              @map("byte_size")
  checksum         String?          @db.Char(64)
  status           String           @db.VarChar(24)
  uploadExpiresAt  DateTime         @map("upload_expires_at") @db.Timestamptz(3)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  team             Team?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project          StoryProject?    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  uploadedBy       User             @relation("AssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedByMember TeamMembership?  @relation("AssetUploaderMembership", fields: [tenantId, uploadedByUserId], references: [tenantId, userId], onDelete: Restrict)
  roleCoverAssets  StoryRoleAsset[] @relation("StoryRoleAssetCover")
  roleViewAssets   StoryRoleAsset[] @relation("StoryRoleAssetView")

  @@unique([tenantId, id], map: "assets_tenant_id_id_key")
  @@index([tenantId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "assets_tenant_id_project_id_created_at_id_idx")
  @@index([tenantId, projectId, status, createdAt(sort: Desc), id(sort: Desc)], map: "assets_tenant_id_project_id_status_idx")
  @@map("assets")
}
