model StoryImportJob {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String?         @map("tenant_id") @db.Uuid
  projectId           String          @map("project_id") @db.Uuid
  createdByUserId     String          @map("created_by_user_id") @db.Uuid
  sourceFileName      String          @map("source_file_name") @db.VarChar(255)
  sourceContentType   String          @map("source_content_type") @db.VarChar(128)
  sourceByteSize      Int             @map("source_byte_size")
  status              String          @default("pending") @db.VarChar(16)
  failureCode         String?         @map("failure_code") @db.VarChar(64)
  processingStartedAt DateTime?       @map("processing_started_at") @db.Timestamptz(3)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  team                Team?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project             StoryProject    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy           User            @relation("StoryImportJobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByMembership TeamMembership? @relation("StoryImportJobCreatorMembership", fields: [tenantId, createdByUserId], references: [tenantId, userId], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "story_import_jobs_project_created_id_idx")
  @@index([tenantId, status, createdAt(sort: Asc)], map: "story_import_jobs_tenant_status_created_idx")
  @@map("story_import_jobs")
}
