generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @unique(map: "users_email_key") @db.VarChar(254)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            Session[]
  securityEvents      IdentitySecurityEvent[]
  createdTeams        Team[]                  @relation("TeamCreator")
  teamMemberships     TeamMembership[]
  auditRecords        AuditRecord[]           @relation("AuditActor")
  sentInvitations     TeamInvitation[]        @relation("TeamInvitationSender")
  acceptedInvitations TeamInvitation[]        @relation("TeamInvitationAcceptor")
  createdStoryProjects StoryProject[]         @relation("StoryProjectCreator")
  projectCollaborations ProjectCollaborator[]
  authoredMessages    Message[]                @relation("MessageAuthor")

  @@map("users")
}

model Team {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(100)
  createdByUserId    String              @map("created_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          User                @relation("TeamCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships        TeamMembership[]
  idempotencyRecords IdempotencyRecord[]
  auditRecords       AuditRecord[]
  invitations        TeamInvitation[]
  storyProjects      StoryProject[]
  projectCollaborators ProjectCollaborator[]
  conversations      Conversation[]
  messages           Message[]
  generationRequests StoryGenerationRequest[]

  @@index([createdByUserId, createdAt(sort: Desc)], map: "teams_created_by_user_id_created_at_idx")
  @@map("teams")
}

model TeamInvitation {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  email                String          @db.VarChar(254)
  invitedByUserId      String          @map("invited_by_user_id") @db.Uuid
  tokenHash            String          @unique(map: "team_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime        @map("expires_at") @db.Timestamptz(3)
  acceptedAt           DateTime?       @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId     String?         @map("accepted_by_user_id") @db.Uuid
  revokedAt            DateTime?       @map("revoked_at") @db.Timestamptz(3)
  team                 Team            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy            User            @relation("TeamInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy           User?           @relation("TeamInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  invitedByMembership  TeamMembership  @relation("TeamInvitationSenderMembership", fields: [tenantId, invitedByUserId], references: [tenantId, userId], onDelete: Restrict)
  acceptedByMembership TeamMembership? @relation("TeamInvitationAcceptorMembership", fields: [tenantId, acceptedByUserId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "team_invitations_tenant_id_created_at_id_idx")
  @@index([tenantId, email, acceptedAt, revokedAt], map: "team_invitations_tenant_id_email_state_idx")
  @@index([expiresAt], map: "team_invitations_expires_at_idx")
  @@map("team_invitations")
}

model TeamMembership {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  role                String           @db.VarChar(16)
  joinedAt            DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt           DateTime?        @map("removed_at") @db.Timestamptz(3)
  team                Team             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sentInvitations     TeamInvitation[] @relation("TeamInvitationSenderMembership")
  acceptedInvitations TeamInvitation[] @relation("TeamInvitationAcceptorMembership")
  auditRecords        AuditRecord[]    @relation("AuditActorMembership")
  projectCollaborations ProjectCollaborator[]
  authoredMessages     Message[]        @relation("MessageAuthorMembership")

  @@unique([tenantId, userId], map: "team_memberships_tenant_id_user_id_key")
  @@unique([tenantId, id], map: "team_memberships_tenant_id_id_key")
  @@index([userId, removedAt], map: "team_memberships_user_id_removed_at_idx")
  @@index([tenantId, role, removedAt], map: "team_memberships_tenant_id_role_removed_at_idx")
  @@map("team_memberships")
}

model StoryProject {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  title             String                  @db.VarChar(200)
  visibility        String                  @db.VarChar(16)
  status            String                  @db.VarChar(16)
  revision          Int                     @default(1)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  team              Team                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("StoryProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  collaborators     ProjectCollaborator[]
  conversations     Conversation[]

  @@unique([tenantId, id], map: "story_projects_tenant_id_id_key")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "story_projects_tenant_id_created_at_id_idx")
  @@index([tenantId, visibility, status, createdAt(sort: Desc)], map: "story_projects_tenant_id_visibility_status_idx")
  @@map("story_projects")
}

model ProjectCollaborator {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  team          Team         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project       StoryProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership    TeamMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict)

  @@unique([tenantId, id], map: "project_collaborators_tenant_id_id_key")
  @@unique([tenantId, projectId, userId], map: "project_collaborators_tenant_id_project_id_user_id_key")
  @@index([tenantId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "project_collaborators_tenant_id_project_id_created_at_id_idx")
  @@map("project_collaborators")
}

model Conversation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  status      String       @db.VarChar(16)
  revision    Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  team        Team         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     StoryProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  messages    Message[]
  generationRequests StoryGenerationRequest[]

  @@unique([tenantId, id], map: "conversations_tenant_id_id_key")
  @@index([tenantId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "conversations_tenant_id_project_id_created_at_id_idx")
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  authorType     String           @map("author_type") @db.VarChar(16)
  authorUserId   String?          @map("author_user_id") @db.Uuid
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  team           Team             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation   Conversation     @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  author         User?            @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorMembership TeamMembership? @relation("MessageAuthorMembership", fields: [tenantId, authorUserId], references: [tenantId, userId], onDelete: Restrict)
  generationRequest StoryGenerationRequest? @relation("GenerationTrigger")
  storyArtifactVersions StoryArtifactVersion[] @relation("StoryArtifactVersionSourceMessage")

  @@unique([tenantId, id], map: "messages_tenant_id_id_key")
  @@unique([tenantId, conversationId, id], map: "messages_tenant_conversation_id_key")
  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "messages_tenant_id_conversation_id_created_at_id_idx")
  @@map("messages")
}

model StoryGenerationRequest {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  triggerMessageId String       @map("trigger_message_id") @db.Uuid
  idempotencyKey   String       @map("idempotency_key") @db.VarChar(128)
  inputSnapshot    Json         @map("input_snapshot") @db.JsonB
  status           String       @db.VarChar(16)
  failureCode      String?      @map("failure_code") @db.VarChar(32)
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(3)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(3)
  agentMessageId   String?      @map("agent_message_id") @db.Uuid
  artifactId       String?      @map("artifact_id") @db.Uuid
  artifactVersionId String?     @map("artifact_version_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  team             Team         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation     Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  triggerMessage   Message      @relation("GenerationTrigger", fields: [tenantId, conversationId, triggerMessageId], references: [tenantId, conversationId, id], onDelete: Restrict)
  storyArtifactVersions StoryArtifactVersion[] @relation("StoryArtifactVersionGenerationRequest")

  @@unique([tenantId, id], map: "story_generation_requests_tenant_id_id_key")
  @@unique([tenantId, conversationId, triggerMessageId], map: "story_gen_requests_tenant_conversation_trigger_key")
  @@unique([tenantId, triggerMessageId], map: "story_generation_requests_tenant_id_trigger_message_id_key")
  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "story_gen_requests_tenant_conversation_created_id_idx")
  @@map("story_generation_requests")
}

model StoryArtifact {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  projectId        String                 @map("project_id") @db.Uuid
  type             String                 @db.VarChar(32)
  title            String                 @db.VarChar(200)
  status           String                 @db.VarChar(16)
  currentVersionId String?                @map("current_version_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  team             Team                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project          StoryProject           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  currentVersion   StoryArtifactVersion?  @relation("StoryArtifactCurrentVersion", fields: [tenantId, currentVersionId], references: [tenantId, id], onDelete: Restrict)
  versions         StoryArtifactVersion[] @relation("StoryArtifactVersions")

  @@unique([tenantId, id], map: "story_artifacts_tenant_id_id_key")
  @@unique([tenantId, currentVersionId], map: "story_artifacts_tenant_id_current_version_id_key")
  @@index([tenantId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "story_artifacts_tenant_id_project_id_created_at_id_idx")
  @@index([tenantId, projectId, type, status, createdAt(sort: Desc)], map: "story_artifacts_tenant_project_type_status_idx")
  @@map("story_artifacts")
}

model StoryArtifactVersion {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  artifactId          String                 @map("artifact_id") @db.Uuid
  versionNumber       Int                    @map("version_number")
  content             String                 @db.Text
  contentFormat       String                 @map("content_format") @db.VarChar(16)
  status              String                 @db.VarChar(16)
  sourceType          String                 @map("source_type") @db.VarChar(16)
  sourceMessageId     String?                @map("source_message_id") @db.Uuid
  generationRequestId String?                @map("generation_request_id") @db.Uuid
  createdByUserId     String?                @map("created_by_user_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  team                Team                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  artifact            StoryArtifact          @relation("StoryArtifactVersions", fields: [tenantId, artifactId], references: [tenantId, id], onDelete: Restrict)
  currentFor          StoryArtifact?         @relation("StoryArtifactCurrentVersion")
  createdBy           User?                  @relation("StoryArtifactVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByMembership TeamMembership?       @relation("StoryArtifactVersionCreatorMembership", fields: [tenantId, createdByUserId], references: [tenantId, userId], onDelete: Restrict)
  sourceMessage       Message?               @relation("StoryArtifactVersionSourceMessage", fields: [tenantId, sourceMessageId], references: [tenantId, id], onDelete: Restrict)
  generationRequest   StoryGenerationRequest? @relation("StoryArtifactVersionGenerationRequest", fields: [tenantId, generationRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "story_artifact_versions_tenant_id_id_key")
  @@unique([tenantId, artifactId, versionNumber], map: "story_artifact_versions_tenant_artifact_version_key")
  @@index([tenantId, artifactId, createdAt(sort: Desc), id(sort: Desc)], map: "story_artifact_versions_tenant_artifact_created_id_idx")
  @@index([tenantId, sourceMessageId], map: "story_artifact_versions_tenant_source_message_idx")
  @@index([tenantId, generationRequestId], map: "story_artifact_versions_tenant_generation_request_idx")
  @@map("story_artifact_versions")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  scopeKey       String   @map("scope_key") @db.VarChar(200)
  operationType  String   @map("operation_type") @db.VarChar(64)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  resultId       String   @map("result_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  team           Team     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, operationType, idempotencyKey], map: "idempotency_records_scope_operation_key_key")
  @@index([tenantId, createdAt(sort: Desc)], map: "idempotency_records_tenant_id_created_at_idx")
  @@map("idempotency_records")
}

model AuditRecord {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  actorUserId     String         @map("actor_user_id") @db.Uuid
  action          String         @db.VarChar(64)
  targetType      String         @map("target_type") @db.VarChar(64)
  targetId        String         @map("target_id") @db.Uuid
  beforeSummary   Json?          @map("before_summary") @db.JsonB
  afterSummary    Json?          @map("after_summary") @db.JsonB
  requestId       String         @map("request_id") @db.VarChar(128)
  occurredAt      DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  team            Team           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor           User           @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership TeamMembership @relation("AuditActorMembership", fields: [tenantId, actorUserId], references: [tenantId, userId], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc), id], map: "audit_records_tenant_id_occurred_at_id_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_records_actor_user_id_occurred_at_idx")
  @@map("audit_records")
}

model Session {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  tokenHash      String                  @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?               @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  securityEvents IdentitySecurityEvent[]

  @@index([userId, createdAt(sort: Desc)], map: "sessions_user_id_created_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model EmailLoginChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.VarChar(254)
  tokenHash    String    @unique(map: "email_login_challenges_token_hash_key") @map("token_hash") @db.Char(64)
  sourceDigest String    @map("source_digest") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  attemptCount Int       @default(0) @map("attempt_count") @db.SmallInt
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt(sort: Desc)], map: "email_login_challenges_email_created_at_idx")
  @@index([sourceDigest, createdAt(sort: Desc)], map: "email_login_challenges_source_created_at_idx")
  @@index([expiresAt], map: "email_login_challenges_expires_at_idx")
  @@map("email_login_challenges")
}

model IdentitySecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.Uuid
  action     String   @db.VarChar(64)
  targetId   String   @map("target_id") @db.Uuid
  requestId  String   @map("request_id") @db.VarChar(128)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)], map: "identity_security_events_user_id_occurred_at_idx")
  @@index([sessionId], map: "identity_security_events_session_id_idx")
  @@index([action, occurredAt(sort: Desc)], map: "identity_security_events_action_occurred_at_idx")
  @@map("identity_security_events")
}
